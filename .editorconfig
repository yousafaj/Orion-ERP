root = true

[*]
indent_style = tab
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{py,pyi}]
indent_style = tab
indent_size = 4

[*.{js,jsx,ts,tsx}]
indent_style = tab
indent_size = 2

[*.{html,css,scss,json,yaml,yml}]
indent_style = tab
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
