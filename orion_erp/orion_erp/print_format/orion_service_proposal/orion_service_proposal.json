 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\r\n@page {\r\n    margin-top: 30px;\r\n}\r\n\r\n\r\n.print-format {\r\n    padding-top: 30px !important;\r\n}\r\n    .letter-head-footer {\r\n        margin: 0 !important;\r\n        padding: 0 !important;\r\n    }\r\n    \r\n    @media screen {\r\n        .print-format {\r\n            width: 9.4in;\r\n            padding: 0.20in;\r\n            min-height: 11.7in;\r\n        }\r\n    }\r\n    .print-format p{\r\n        \r\n    margin:1px 0;\r\n    line-height:1.1;\r\n}\r\n\r\n.print-format td{\r\n    line-height:1.1;\r\n}\r\nbody {\r\n    margin:0 !important;\r\n    padding:0 !important;\r\n}\r\n\r\n\r\n</style>\r\n\r\n<!-- HEADER -->\r\n<div id=\"header-html\">\r\n\r\n   <div style=\"position:relative; width:100%; height:80px;\">\r\n\r\n    <!-- Client Logo -->\r\n    <div style=\"position:absolute; left:0; top:0;\">\r\n        {% if doc.custom_client_logo %}\r\n            <img src=\"{{ doc.custom_client_logo }}\"\r\n                 style=\"height:55px; width:auto;\">\r\n        {% else %}\r\n            <span style=\"font-size:16px;\">Client's Logo</span>\r\n        {% endif %}\r\n    </div>\r\n\r\n    <!-- Company Logo -->\r\n    <div style=\"position:absolute; right:0; top:0;\">\r\n        {% set logo = frappe.db.get_value(\"Orion Settings\", None, \"company_logo\") %}\r\n        {% if logo %}\r\n            <img src=\"{{ frappe.utils.get_url(logo) }}\"\r\n                 style=\"height:55px; width:auto;\">\r\n        {% endif %}\r\n    </div>\r\n\r\n\r\n</div>\r\n\r\n</div>\r\n\r\n   <div style=\"margin-top:40px; font-size:12px; font-weight:bold; line-height:1.6;\">\r\n    Quotation No.: {{ doc.name }}<br>\r\n    Date: {{ frappe.utils.formatdate(doc.transaction_date, \"dd MMMM yyyy\") }}<br>\r\n    Valid Until: {{ frappe.utils.formatdate(doc.valid_till, \"dd MMMM yyyy\") }}\r\n</div>\r\n\r\n{% if doc.quotation_to == \"Lead\" %}\r\n    {% set lead = frappe.get_doc(\"Lead\", doc.party_name) %}\r\n{% endif %}\r\n\r\n<div style=\"margin-top:50px; width:100%;\">\r\n\r\n    <!-- Prepared For -->\r\n    <div style=\"width:45%; float:left;\">\r\n\r\n        <div style=\"font-size:12px; font-weight:bold; margin-bottom:12px;\">\r\n            Prepared For\r\n        </div>\r\n\r\n        <div style=\"font-size:12px; line-height:1.8;\">\r\n\r\n            <b>Client Name:</b>\r\n            {{ lead.lead_name if doc.quotation_to==\"Lead\" else doc.customer_name }}\r\n            <br>\r\n\r\n            <b>Contact Person:</b>\r\n            {{ lead.lead_name if doc.quotation_to==\"Lead\" else \"\" }}\r\n            <br>\r\n\r\n            <b>Designation:</b>\r\n            {{ lead.job_title if doc.quotation_to==\"Lead\" else \"\" }}\r\n            <br>\r\n\r\n            <b>Contact No.:</b>\r\n            {{ lead.mobile_no if doc.quotation_to==\"Lead\" else \"\" }}\r\n            <br>\r\n\r\n            <b>Email:</b>\r\n            {{ lead.email_id if doc.quotation_to==\"Lead\" else \"\" }}\r\n            <br>\r\n\r\n            <b>TRN/VAT No.:</b>\r\n            {{ lead.custom_trn_vat_number if doc.quotation_to==\"Lead\" else \"\" }}\r\n\r\n        </div>\r\n\r\n    </div>\r\n\r\n    <!-- Prepared By -->\r\n    <div style=\"width:40%; float:right;\">\r\n         {% set company = frappe.get_doc(\"Company\", doc.company) %}\r\n        {% set employee = frappe.get_doc(\"Employee\", doc.custom_prepared_by) %}\r\n\r\n        <div style=\"font-size:12px; font-weight:bold; margin-bottom:12px;\">\r\n            Prepared By\r\n        </div>\r\n\r\n        <div style=\"font-size:12px; line-height:1.8;\">\r\n\r\n            <b>Company Name:</b>\r\n            {{ doc.company }}\r\n            <br>\r\n\r\n            <b>Contact Person:</b>\r\n            {{ employee.employee_name }}\r\n            <br>\r\n\r\n            \r\n            <b>Designation:</b>\r\n            {{ employee.designation or \"\" }}\r\n            <br>\r\n\r\n            <b>Contact No.:</b>\r\n            {{ employee.custom_mobile or \"\" }}\r\n            <br>\r\n\r\n            <b>Email:</b>\r\n            {{ employee.user_id or \"\" }}\r\n            <br>\r\n\r\n            <b>TRN/VAT No.: {{ company.custom_trn_vat_number or \"\" }}</b>\r\n\r\n        </div>\r\n\r\n    </div>\r\n\r\n    <div style=\"clear:both;\"></div>\r\n\r\n</div>\r\n\r\n<!-- SUBJECT -->\r\n\r\n<!-- SUBJECT -->\r\n\r\n<div style=\"margin-top:40px; margin-bottom:15px;\">\r\n\r\n    <div style=\"\r\n        font-size:12px;\r\n        font-weight:bold;\r\n        margin-bottom:5px;\r\n    \">\r\n        Quotation for {{ doc.custom_quotation_for or \"\" }}\r\n    </div>\r\n\r\n    <div style=\"\r\n        font-size:12px;\r\n        font-weight:bold;\r\n    \">\r\n        Project Location:\r\n        {{ doc.custom_location or \"\" }}\r\n    </div>\r\n\r\n</div>\r\n\r\n<!-- INTRO -->\r\n\r\n<div style=\"margin-top:10px; margin-bottom:10px;\">\r\n\r\n    <div style=\"\r\n        font-size:12px;\r\n        font-weight:bold;\r\n        margin-bottom:10px;\r\n    \">\r\n        Dear {{ doc.customer_name or \"Customer\" }},\r\n    </div>\r\n\r\n    <div style=\"\r\n        font-size:12px;\r\n        line-height:1.6;\r\n        text-align:justify;\r\n    \">\r\n        Thank you for the opportunity to provide our quotation.\r\n        We are pleased to submit our pricing for the supply of\r\n        services/products described below.\r\n    </div>\r\n\r\n</div>\r\n\r\n<!-- SCOPE OF WORK -->\r\n\r\n<div style=\"\r\n    font-size:14px;\r\n    font-weight:bold;\r\n    \r\n    margin-top:20px;\r\n    margin-bottom:10px;\r\n    display:inline-block;\r\n\">\r\n    SCOPE OF WORK / DESCRIPTION\r\n</div>\r\n\r\n<div style=\"\r\n    font-size:12px;\r\n    margin-bottom:10px;\r\n\">\r\n    The quotation covers the following services/products:\r\n</div>\r\n\r\n<table style=\"\r\n    width:100%;\r\n    border-collapse:collapse;\r\n    border-spacing:0;\r\n    font-size:12px;\r\n    margin:0;\r\n    padding:0;\r\n\">\r\n\r\n    <thead>\r\n        <tr style=\"background:#8ccf6f; margin:0; padding:0;\">\r\n\r\n            <th style=\"\r\n                border:1px solid #000;\r\n                text-align:center;\r\n                color:#000 !important;\r\n                font-weight:bold !important;\r\n                padding:0;\r\n                margin:0;\r\n            \">\r\n                Sn. No.\r\n            </th>\r\n\r\n            <th style=\"\r\n                border:1px solid #000;\r\n                text-align:center;\r\n                color:#000 !important;\r\n                font-weight:bold !important;\r\n                padding:0;\r\n                margin:0;\r\n            \">\r\n                Service Description\r\n            </th>\r\n\r\n            <th style=\"\r\n                border:1px solid #000;\r\n                text-align:center;\r\n                color:#000 !important;\r\n                font-weight:bold !important;\r\n                padding:0;\r\n                margin:0;\r\n            \">\r\n                {% if doc.custom_quotation_for == \"Hazardous Waste Management Collection Service\"\r\n               or doc.custom_quotation_for == \"Pest Control Service\"\r\n               or doc.custom_quotation_for == \"Vehicle Rental Service\" %}\r\n               Capacity\r\n               {% else %}\r\n                Location\r\n                {% endif %}\r\n            </th>\r\n\r\n            <th style=\"\r\n                border:1px solid #000;\r\n                text-align:center;\r\n                color:#000 !important;\r\n                font-weight:bold !important;\r\n                padding:0;\r\n                margin:0;\r\n            \">\r\n                {% if doc.custom_quotation_for==\"Vehicle Rental Service\" %}\r\n                Location\r\n                {% else %}\r\n                Frequency\r\n                {% endif %}\r\n                \r\n            </th>\r\n\r\n        </tr>\r\n    </thead>\r\n\r\n    <tbody>\r\n\r\n        {% for row in doc.items %}\r\n\r\n        <tr style=\"margin:0; padding:0;\">\r\n\r\n            <td style=\"\r\n                border:1px solid #000;\r\n                text-align:center;\r\n                vertical-align:middle;\r\n                padding:0;\r\n                margin:0;\r\n            \">\r\n                 {{ \"%02d\"|format(loop.index) }}\r\n            </td>\r\n\r\n           <td style=\"\r\n            border:1px solid #000;\r\n            text-align:center !important;\r\n            vertical-align:middle;\r\n            padding:4px;\r\n        \">\r\n            {{ frappe.utils.strip_html(row.custom_service_description or row.item_name) }}\r\n        </td>\r\n\r\n            <td style=\"\r\n                border:1px solid #000;\r\n                text-align:center;\r\n                vertical-align:middle;\r\n                padding:0;\r\n                margin:0;\r\n            \">\r\n                {% if doc.custom_quotation_for == \"Hazardous Waste Management Collection Service\"\r\n               or doc.custom_quotation_for == \"Pest Control Service\"\r\n               or doc.custom_quotation_for == \"Vehicle Rental Service\" %}\r\n              {{ row.custom_capacity or \"\" }}\r\n               {% else %}\r\n               {{ row.custom_item_location or \"\" }}\r\n                {% endif %}\r\n                \r\n            </td>\r\n\r\n            <td style=\"\r\n                border:1px solid #000;\r\n                text-align:center;\r\n                vertical-align:middle;\r\n                padding:0;\r\n                margin:0;\r\n            \">\r\n                {% if doc.custom_quotation_for==\"Vehicle Rental Service\" %}\r\n                {{row.qty}}\r\n                {% else %}\r\n                {{row.custom_frequency or \"\"}}\r\n                {% endif %}\r\n            </td>\r\n\r\n        </tr>\r\n\r\n        {% endfor %}\r\n\r\n    </tbody>\r\n\r\n</table>\r\n<div style=\"\r\n    margin-top:15px;\r\n    font-size:12px;\r\n    line-height:1.5;\r\n\">\r\n    Any work not specifically mentioned in this quotation shall\r\n    be considered outside the scope and may be subject to\r\n    additional charges.\r\n</div>\r\n\r\n<!-- COMMERCIAL OFFER -->\r\n\r\n<div style=\"\r\n    font-size:13px;\r\n    font-weight:bold;\r\n    \r\n    display:inline-block;\r\n   \r\n    margin-top:15px;\r\n    margin-bottom:0;\r\n\">\r\n    COMMERCIAL OFFER\r\n</div>\r\n\r\n<table style=\"\r\n    width:100%;\r\n    border-collapse:collapse;\r\n    border-spacing:0;\r\n    font-size:12px;\r\n    margin-top:0;\r\n\">\r\n\r\n    <thead>\r\n\r\n        <tr style=\"background:#8ccf6f;\">\r\n\r\n            <th style=\"\r\n                border:1px solid #000;\r\n                text-align:center;\r\n                color:#000;\r\n                font-weight:bold;\r\n                width:8%;\r\n                padding:4px;\r\n            \">\r\n                Sn.No.\r\n            </th>\r\n\r\n            <th style=\"\r\n                border:1px solid #000;\r\n                text-align:center;\r\n                color:#000;\r\n                font-weight:bold;\r\n                width:54%;\r\n                padding:4px;\r\n            \">\r\n                Service Description\r\n            </th>\r\n\r\n            <th style=\"\r\n                border:1px solid #000;\r\n                text-align:center;\r\n                color:#000;\r\n                font-weight:bold;\r\n                width:12%;\r\n                padding:4px;\r\n            \">\r\n                 {% if doc.custom_quotation_for == \"Hazardous Waste Management Collection Service\"\r\n               or doc.custom_quotation_for == \"Pest Control Service\"\r\n               or doc.custom_quotation_for == \"Vehicle Rental Service\" %}\r\n               Capacity\r\n               {%else%}\r\n                Location\r\n                {% endif %}\r\n            </th>\r\n\r\n            <th style=\"\r\n                border:1px solid #000;\r\n                text-align:center;\r\n                color:#000;\r\n                font-weight:bold;\r\n                width:10%;\r\n                padding:4px;\r\n            \">\r\n               {% if doc.custom_quotation_for==\"Vehicle Rental Service\" %}\r\n                Location\r\n                {% else %}\r\n                Frequency\r\n                {% endif %}\r\n            </th>\r\n\r\n            <th style=\"\r\n                border:1px solid #000;\r\n                text-align:center;\r\n                color:#000;\r\n                font-weight:bold;\r\n                width:16%;\r\n                padding:4px;\r\n            \">\r\n                {% if doc.custom_quotation_for!=\"Vehicle Rental Service\" %}\r\n                Unit Price ({{ doc.currency }})\r\n                {% else %}\r\n                Monthly<br>\r\n                Rate/Unit<br>\r\n                ({{ doc.currency }})\r\n                {% endif %}\r\n            </th>\r\n\r\n        </tr>\r\n\r\n    </thead>\r\n\r\n    <tbody>\r\n\r\n        {% for row in doc.items %}\r\n\r\n        <tr>\r\n\r\n            <td style=\"\r\n                border:1px solid #000;\r\n                text-align:center;\r\n                vertical-align:middle;\r\n                padding:4px;\r\n            \">\r\n                {{ \"%02d\"|format(loop.index) }}\r\n            </td>\r\n\r\n                <td style=\"\r\n                    border:1px solid #000;\r\n                    text-align:center !important;\r\n                    vertical-align:middle;\r\n                    padding:4px;\r\n                \">\r\n                    {{ frappe.utils.strip_html(row.custom_service_description or row.item_name) }}\r\n                </td>\r\n\r\n            <td style=\"\r\n                border:1px solid #000;\r\n                text-align:center;\r\n                vertical-align:middle;\r\n                padding:4px;\r\n            \">\r\n                {{ row.custom_item_location or \"\" }}\r\n            </td>\r\n\r\n            <td style=\"\r\n                border:1px solid #000;\r\n                text-align:center;\r\n                vertical-align:middle;\r\n                padding:4px;\r\n            \">\r\n                {% if doc.custom_quotation_for==\"Vehicle Rental Service\" %}\r\n                {{row.qty or \"\"}}\r\n                {% else %}\r\n                {{row.custom_frequency or \"\"}}\r\n                {% endif %}\r\n            </td>\r\n\r\n            <td style=\"\r\n                border:1px solid #000;\r\n                text-align:center;\r\n                vertical-align:middle;\r\n                padding:4px;\r\n            \">\r\n                {{ frappe.utils.fmt_money(row.rate, currency=doc.currency) }}\r\n            </td>\r\n\r\n        </tr>\r\n\r\n        {% endfor %}\r\n\r\n    </tbody>\r\n\r\n</table>\r\n\r\n\r\n\r\n\r\n\r\n<div style=\"clear:both;\"></div>\r\n\r\n<br><br>\r\n\r\n<style>\r\n.terms-section {\r\n    font-size: 12px;\r\n    line-height: 1.6;\r\n}\r\n\r\n.terms-section *:not(b):not(strong) {\r\n    color: #000000 !important;\r\n}\r\n\r\n/* Table Borders */\r\n.terms-section table {\r\n    width: 100% !important;\r\n    border-collapse: collapse !important;\r\n    border: 1px solid #000 !important;\r\n}\r\n\r\n.terms-section table td,\r\n.terms-section table th {\r\n    border: 1px solid #000 !important;\r\n    padding: 6px !important;\r\n    color: #000000 !important;\r\n}\r\n\r\n.terms-section table th {\r\n    font-weight: bold;\r\n}\r\n</style>\r\n\r\n<div class=\"terms-section\">\r\n    {{ doc.terms }}\r\n</div>\r\n\r\n\r\n<!-- APPROVAL -->\r\n\r\n<!-- PROPOSAL APPROVAL -->\r\n\r\n<div style=\"\r\n    font-size:13px;\r\n    font-weight:bold;\r\n    margin-top:20px;\r\n    margin-bottom:0;\r\n\">\r\n    PROPOSAL APPROVAL\r\n</div>\r\n\r\n<div style=\"\r\n    font-size:12px;\r\n    margin-bottom:5px;\r\n    line-height:1.3;\r\n\">\r\n    Should you find our proposal competitive please send back copy of the same with\r\n    signature and stamp and issue an official LPO accordingly.\r\n</div>\r\n\r\n<table style=\"\r\n    width:100%;\r\n    border-collapse:collapse;\r\n    border-spacing:0;\r\n    font-size:12px;\r\n\">\r\n\r\n    <thead>\r\n\r\n        <tr style=\"background:#8ccf6f;\">\r\n\r\n            <th style=\"\r\n                border:1px solid #000;\r\n                text-align:center;\r\n                font-weight:bold;\r\n                color:#000;\r\n                padding:8px;\r\n                width:22%;\r\n            \">\r\n                Company Stamp\r\n            </th>\r\n\r\n            <th style=\"\r\n                border:1px solid #000;\r\n                text-align:center;\r\n                font-weight:bold;\r\n                color:#000;\r\n                padding:8px;\r\n                width:22%;\r\n            \">\r\n                Representative\r\n            </th>\r\n\r\n            <th style=\"\r\n                border:1px solid #000;\r\n                text-align:center;\r\n                font-weight:bold;\r\n                color:#000;\r\n                padding:8px;\r\n                width:15%;\r\n            \">\r\n                Date\r\n            </th>\r\n\r\n            <th style=\"\r\n                border:1px solid #000;\r\n                text-align:center;\r\n                font-weight:bold;\r\n                color:#000;\r\n                padding:8px;\r\n                width:19%;\r\n            \">\r\n                Signature\r\n            </th>\r\n\r\n            <th style=\"\r\n                border:1px solid #000;\r\n                text-align:center;\r\n                font-weight:bold;\r\n                color:#000;\r\n                padding:8px;\r\n                width:22%;\r\n            \">\r\n                Stamp\r\n            </th>\r\n\r\n        </tr>\r\n\r\n    </thead>\r\n\r\n    <tbody>\r\n\r\n        <tr>\r\n\r\n            <td style=\"\r\n                border:1px solid #000;\r\n                height:120px;\r\n            \"></td>\r\n\r\n            <td style=\"\r\n                border:1px solid #000;\r\n                height:120px;\r\n            \"></td>\r\n\r\n            <td style=\"\r\n                border:1px solid #000;\r\n                height:120px;\r\n            \"></td>\r\n\r\n            <td style=\"\r\n                border:1px solid #000;\r\n                height:120px;\r\n            \"></td>\r\n\r\n            <td style=\"\r\n                border:1px solid #000;\r\n                height:120px;\r\n            \"></td>\r\n\r\n        </tr>\r\n\r\n    </tbody>\r\n\r\n</table>\r\n\r\n<!-- FOOTER SECTION -->\r\n{% set company = frappe.get_doc(\"Company\", doc.company) %}\r\n{% set employee = frappe.get_doc(\"Employee\", doc.employee) %}\r\n{% set letter_head = frappe.get_doc(\"Letter Head\", company.default_letter_head) %}\r\n<div id=\"footer-html\">\r\n\r\n    {% if letter_head.footer_image %}\r\n    <div class=\"footer-img\">\r\n        <img src=\"{{ letter_head.footer_image }}\">\r\n    </div>\r\n    {% endif %}\r\n\r\n</div>\r\n",
