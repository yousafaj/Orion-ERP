{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-06-22 09:52:59.016011",
 "custom_format": 1,
 "default_print_language": "en-US",
 "disabled": 0,
 "doc_type": "Purchase Order",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\r\n   \r\n    @page {\r\n        margin-top: 20px;\r\n    }\r\n\r\n    \r\n    @media screen {\r\n        .print-format {\r\n            width: 9.4in;\r\n            padding: 0.20in;\r\n            min-height: 11.7in;\r\n        }\r\n    }\r\n    .print-format p{\r\n    margin:1px 0;\r\n    line-height:1.1;\r\n}\r\n    \r\n\r\n</style>\r\n\r\n{% if doc.company == \"Orion Environmental Services & Transport\u00a0LLC\" %}\r\n    {% set primary_green = \"#8FAF8A\" %}\r\n{% else %}\r\n    {% set primary_green = \"#2f6b3c\" %}\r\n{% endif %}\r\n\r\n<div id=\"header-html\" style=\"height:10px;\">\r\n    <div class=\"header-img\"></div>\r\n</div>\r\n{% set logo = get_company_logo() %}\r\n\r\n{% set company_address = frappe.db.sql(\"\"\"\r\n    SELECT\r\n        a.address_line1,\r\n        a.address_line2,\r\n        a.city,\r\n        a.phone,\r\n        a.email_id,\r\n        a.pincode,\r\n        a.emirate,\r\n        a.state,\r\n        a.country\r\n    FROM `tabAddress` a\r\n    INNER JOIN `tabDynamic Link` dl ON dl.parent = a.name\r\n    WHERE dl.link_doctype='Company' AND dl.link_name=%s\r\n    LIMIT 1\r\n\"\"\", (doc.company,), as_dict=1) %}\r\n\r\n{% set supplier_address = None %}\r\n{% if doc.supplier_address %}\r\n    {% set supplier_address = frappe.db.get_value(\r\n        \"Address\",\r\n        doc.supplier_address,\r\n        [\r\n            \"address_line1\",\r\n            \"address_line2\",\r\n            \"city\",\r\n            \"state\",\r\n            \"emirate\",\r\n            \"country\"\r\n        ],\r\n        as_dict=True\r\n    ) %}\r\n{% endif %}\r\n\r\n\r\n{% if not supplier_address %}\r\n    {% set supplier_addr_name = frappe.db.get_value(\"Dynamic Link\", {\"link_doctype\": \"Supplier\", \"link_name\": doc.supplier, \"parenttype\": \"Address\"}, \"parent\") %}\r\n    {% if supplier_addr_name %}\r\n        {% set supplier_address = frappe.db.get_value(\r\n            \"Address\",\r\n            supplier_addr_name,\r\n            [\r\n                \"address_line1\",\r\n                \"address_line2\",\r\n                \"city\",\r\n                \"state\",\r\n                \"emirate\",\r\n                \"country\"\r\n            ],\r\n            as_dict=True\r\n        ) %}\r\n    {% endif %}\r\n{% endif %}\r\n\r\n{% set company_trn = doc.company_trn or frappe.db.get_value(\"Company\", doc.company, \"tax_id\") %}\r\n{% set supplier_trn = frappe.db.get_value(\"Supplier\", doc.supplier, \"tax_id\") %}\r\n\r\n{% set company_abbr = \"\" %}\r\n{% if doc.company %}\r\n    {% for w in doc.company.split() %}\r\n        {% if w[0].isupper() and w not in [\"LLC\", \"L.L.C\"] %}\r\n            {% set company_abbr = company_abbr + w[0] %}\r\n        {% endif %}\r\n    {% endfor %}\r\n{% endif %}\r\n\r\n<table style=\"width:100%; border-collapse:collapse; margin-bottom:30px;\">\r\n    <tr>\r\n        <!-- Logo -->\r\n        <td style=\"width:25%; vertical-align:middle;\">\r\n            {% if logo %}\r\n            <img src=\"{{ logo }}\" style=\"height:55px;\">\r\n            {% endif %}\r\n        </td>\r\n\r\n        <!-- Title -->\r\n        <td style=\"width:68%; text-align:right; vertical-align:middle;\">\r\n            <div style=\"font-size:25px; font-weight:700; color:#1a1a1a; letter-spacing:-0.5px;margin-top:20px\">\r\n                Purchase Order\r\n            </div>\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n<table style=\"width:100%; border-collapse:collapse; border-spacing:0; font-size:10px;\">\r\n<tr>\r\n\r\n<!-- ISSUED BY -->\r\n<td width=\"30%\" style=\"vertical-align:top; padding-right:8px;\">\r\n\r\n<p style=\"margin:0 0 6px 0;font-size:9px; margin-bottom:20px;margin-top:-20px\">Issued By</p>\r\n\r\n<p style=\"margin:0 0 6px 0; font-weight:bold; text-transform:uppercase;font-size:9px;\">\r\n{{ doc.company }}\r\n</p>\r\n\r\n{% if company_address and company_address[0] %}\r\n{% set addr = company_address[0] %}\r\n<p style=\"margin:0 0 4px 0; font-size:9px;\">\r\n    {{ addr.address_line1 or \"\" }}<br>\r\n    {% if addr.address_line2 %}{{ addr.address_line2 }}<br>{% endif %}\r\n    {{ addr.city or \"\" }}<br>\r\n    {{ addr.country or \"\" }}\r\n    {% if addr.pincode %} - {{ addr.pincode }}{% endif %}<br><br>\r\n\r\n    {% if addr.phone %}\r\n    Phone: {{ addr.phone }}<br>\r\n    {% endif %}\r\n\r\n    {% if addr.email_id %}\r\n    Email: {{ addr.email_id }}\r\n    {% endif %}\r\n</p>\r\n{% endif %}\r\n\r\n{% if company_trn %}\r\n<p style=\"margin:0; font-weight:bold;\">\r\nTRN : {{ company_trn }}\r\n</p>\r\n{% endif %}\r\n\r\n</td>\r\n\r\n\r\n<!-- ISSUED TO -->\r\n<td width=\"32%\" style=\"vertical-align:top; padding-right:8px;\">\r\n\r\n<p style=\"margin:0 0 6px 0;font-size:9px;margin-bottom:20px;margin-top:-20px\">Issued To</p>\r\n\r\n<p style=\"margin:0 0 6px 0; font-weight:bold;font-size:9px;\">\r\n{{ doc.supplier_name }}\r\n</p>\r\n\r\n{% if supplier_address %}\r\n<p style=\"margin:0 0 4px 0; font-size:9px;\">\r\n    {{ supplier_address.address_line1 or \"\" }}<br>\r\n    {% if supplier_address.address_line2 %}\r\n        {{ supplier_address.address_line2 }}<br>\r\n    {% endif %}\r\n    {{ supplier_address.city or \"\" }}<br>\r\n    {{ supplier_address.country or \"\" }}\r\n    {% if supplier_address.pincode %}\r\n        - {{ supplier_address.pincode }}\r\n    {% endif %}\r\n</p>\r\n{% endif %}\r\n\r\n{% if supplier_address.phone %}\r\n<p style=\"margin:0 0 4px 0; font-size:9px;\">\r\nContact: {{ supplier_address.phone }}\r\n</p>\r\n{% endif %}\r\n\r\n{% if supplier_address.email_id %}\r\n<p style=\"margin:0 0 4px 0; font-size:9px;\">\r\nEmail: {{ supplier_address.email_id }}\r\n</p>\r\n{% endif %}\r\n\r\n{% if supplier_trn %}\r\n<p style=\"margin:0; font-weight:bold;\">\r\nTRN : {{ supplier_trn }}\r\n</p>\r\n{% endif %}\r\n\r\n</td>\r\n\r\n\r\n<!-- PO DETAILS -->\r\n<td width=\"26%\" style=\"vertical-align:top;\">\r\n\r\n<p style=\"margin:0;margin-bottom:20px;margin-top:-20px\">PO Details</p>\r\n\r\n<table style=\"width:100%; border-collapse:collapse; font-size:9px; margin:0;\">\r\n\r\n<tr> \r\n<td style=\"white-space:nowrap; padding:2px 0 !important; line-height:1.15;\">PO Number</td>\r\n<td style=\"width:20px; text-align:center;padding:2px 0 !important; line-height:1.15;\">:</td> \r\n<td style=\"padding:2px 0 !important; line-height:1.15;\">{{ doc.name }}</td> </tr>\r\n<tr>\r\n<td style=\"white-space:nowrap; padding:2px 0 !important; line-height:1.15;\">Date</td>\r\n<td style=\"text-align:center; padding:2px 0 !important; line-height:1.15;\">:</td>\r\n<td style=\"padding:2px 0 !important; line-height:1.15;\">\r\n{{ frappe.utils.formatdate(doc.transaction_date, \"dd-MM-yyyy\") }}\r\n</td>\r\n</tr>\r\n\r\n{% if doc.payment_terms_template %}\r\n<tr>\r\n<td style=\"white-space:nowrap; padding:2px 0 !important; line-height:1.15;\">Payment Terms</td>\r\n<td style=\"text-align:center; padding:2px 0 !important; line-height:1.15;\">:</td>\r\n<td style=\"padding:2px 0 !important; line-height:1.15;\">\r\n{{ doc.payment_terms_template }}\r\n</td>\r\n</tr>\r\n{% endif %}\r\n\r\n<tr>\r\n<td style=\"white-space:nowrap; padding:2px 0 !important; line-height:1.15;\">Deliver To</td>\r\n<td style=\"text-align:center; padding:2px 0 !important; line-height:1.15;\">:</td>\r\n<td style=\"padding:2px 0 !important; line-height:1.15;\">\r\n{{ doc.set_warehouse.split(' - ')[0] if doc.set_warehouse else company_abbr }}\r\n</td>\r\n</tr>\r\n\r\n</table>\r\n\r\n</td>\r\n\r\n</tr>\r\n</table>\r\n\r\n<!-- ITEMS TABLE -->\r\n<table style=\"width:100%; border-collapse:collapse; border-spacing:0; margin:5px 0 0 0; font-size:9px; line-height:1;\">\r\n   <thead>\r\n    <tr style=\"background-color:{{ primary_green }}; color:#ffffff !important; white-space:nowrap;\">\r\n        <th style=\"padding:2px 3px; text-align:center; width:5%; border:none; color:#ffffff !important; font-weight:bold !important;\">#</th>\r\n        <th style=\"padding:2px 3px; text-align:left; width:45%; border:none; color:#ffffff !important; font-weight:bold !important;\">Item &amp; Description</th>\r\n        <th style=\"padding:2px 3px; text-align:center; width:10%; border:none; color:#ffffff !important; font-weight:bold !important;\">Qty</th>\r\n        <th style=\"padding:2px 3px; text-align:right; width:10%; border:none; color:#ffffff !important; font-weight:bold !important;\">Rate ({{ doc.currency }})</th>\r\n        <th style=\"padding:2px 3px; text-align:right; width:10%; border:none; color:#ffffff !important; font-weight:bold !important;\">Tax %</th>\r\n        <th style=\"padding:2px 3px; text-align:right; width:10%; border:none; color:#ffffff !important; font-weight:bold !important;\">Tax ({{ doc.currency }})</th>\r\n        <th style=\"padding:2px 3px; text-align:right; width:10%; border:none; color:#ffffff !important; font-weight:bold !important;\">Amount ({{ doc.currency }})</th>\r\n    </tr>\r\n</thead>\r\n\r\n    <tbody>\r\n        {% for row in doc.items %}\r\n        <tr style=\"border-bottom:0.5px solid #e5e5e5; vertical-align:top;\">\r\n            <td style=\"padding:1px 3px; margin:0; text-align:center; font-size:7.5px; line-height:1;\">\r\n                {{ loop.index }}\r\n            </td>\r\n\r\n             <td style=\"padding:2px 3px; text-align:left; font-size:9px; line-height:1.3;\">\r\n    {{\r\n        (row.description or row.item_name or row.item_code)\r\n        | replace(\"</p><p>\", \"<br>\")\r\n        | replace(\"<p>\", \"\")\r\n        | replace(\"</p>\", \"\")\r\n        | safe\r\n    }}\r\n</td>\r\n            <td style=\"padding:1px 3px; margin:0; text-align:center; white-space:nowrap; font-size:7.5px; line-height:1;\">\r\n                {{ \"{:,.2f}\".format(row.qty) }}{% if row.uom %} <span style=\"font-size:7px;\">({{ row.uom }})</span>{% endif %}\r\n            </td>\r\n\r\n            <td style=\"padding:1px 3px; margin:0; text-align:right; white-space:nowrap; font-size:7.5px;\">\r\n                {{ \"{:,.2f}\".format(row.rate) }}\r\n            </td>\r\n\r\n            <td style=\"padding:1px 3px; margin:0; text-align:right; white-space:nowrap; font-size:7.5px;\">\r\n                {{ \"{:,.2f}\".format(row.tax_rate) }}%\r\n            </td>\r\n\r\n            <td style=\"padding:1px 3px; margin:0; text-align:right; white-space:nowrap; font-size:7.5px;\">\r\n                {{ \"{:,.2f}\".format(row.tax_amount) }}\r\n            </td>\r\n\r\n            <td style=\"padding:1px 3px; margin:0; text-align:right; white-space:nowrap; font-size:7.5px;\">\r\n                {{ \"{:,.2f}\".format(row.amount) }}\r\n            </td>\r\n        </tr>\r\n        {% endfor %}\r\n    </tbody>\r\n</table>\r\n\r\n<!-- TOTALS SECTION -->\r\n<table style=\"width:100%;  border-collapse:collapse; font-size:9px;\">\r\n    <tr>\r\n\r\n        <!-- LEFT EMPTY AREA -->\r\n        <td style=\"width:58%;\"></td>\r\n\r\n        <!-- TOTALS -->\r\n        <td style=\"width:42%; vertical-align:top;\">\r\n\r\n            <table style=\"width:100%; border-collapse:collapse;\">\r\n\r\n                <tr>\r\n                    <td style=\"padding:6px 8px; color:#444; font-size:9px;\">\r\n                        Amount\r\n                    </td>\r\n                    <td style=\"padding:6px 8px; text-align:right; white-space:nowrap; font-size:9px;color:#444\">\r\n                       {{ \"{:,.2f}\".format(doc.total) }} AED\r\n                    </td>\r\n                </tr>\r\n\r\n                {% for tax in doc.taxes %}\r\n                <tr>\r\n                    <td style=\" font-size:9px;color:#444\">\r\n                        {{ tax.description }} ({{ \"{:,.1f}\".format(tax.rate).replace(\".0\", \"\") }}%)\r\n                    </td>\r\n                    <td style=\"text-align:right; white-space:nowrap; font-size:9px;color:#444\">\r\n                         {{ \"{:,.2f}\".format(tax.tax_amount) }} AED\r\n                    </td>\r\n                </tr>\r\n                {% endfor %}\r\n                \r\n                <tr style=\"background:{{primary_green}}\">\r\n                    <td style=\"\r\n                        color:#fff;\r\n                        font-size:9px;\r\n                        font-weight:bold;\r\n                        padding:8px 10px;\r\n                    \">\r\n                        Total ({{ doc.currency }})\r\n                    </td>\r\n\r\n                    <td style=\"\r\n                        color:#fff;\r\n                        font-size:9px;\r\n                        font-weight:bold;\r\n                        text-align:right;\r\n                        padding:8px 10px;\r\n                        white-space:nowrap;\r\n                    \">\r\n                        {{ \"{:,.2f}\".format(doc.grand_total) }} AED\r\n                    </td>\r\n                </tr>\r\n\r\n            </table>\r\n\r\n            <div style=\"\r\n                margin-top:8px;\r\n                color:#555;\r\n                font-size:9px;\r\n                line-height:1.6;\r\n            \">\r\n                Total (in words):\r\n                <span style=\"font-weight:bold; color:#444;\">\r\n                    {{ doc.in_words }}\r\n                </span>\r\n            </div>\r\n\r\n        </td>\r\n\r\n    </tr>\r\n</table>\r\n\r\n<!-- TAX SUMMARY SECTION -->\r\n<div style=\"font-size:9px; font-weight:700; color:#2f6b3c; text-decoration:underline; letter-spacing:0.5px; margin-top:20px; margin-bottom:8px; text-transform:uppercase;\">\r\n    Tax Summary\r\n</div>\r\n\r\n<table style=\"width:100%; border-collapse:collapse; border-spacing:0; margin:3px 0; font-size:8px; line-height:1;\">\r\n    <thead>\r\n        <tr style=\"background-color:#eef7f2; border-bottom:0.5px solid #eaeaea;\">\r\n            <th style=\"padding:2px 4px; margin:0; text-align:left; border:none; color:#2f6b3c !important; font-weight:bold !important;\">\r\n                Tax Rate\r\n            </th>\r\n            <th style=\"padding:2px 4px; margin:0; text-align:center; width:15%; border:none; color:#2f6b3c !important; font-weight:bold !important;\">\r\n                Rate\r\n            </th>\r\n            <th style=\"padding:2px 4px; margin:0; text-align:right; width:25%; border:none; color:#2f6b3c !important; font-weight:bold !important;\">\r\n                Amount ({{ doc.currency }})\r\n            </th>\r\n            <th style=\"padding:2px 4px; margin:0; text-align:right; width:25%; border:none; color:#2f6b3c !important; font-weight:bold !important;\">\r\n                Total ({{ doc.currency }})\r\n            </th>\r\n        </tr>\r\n    </thead>\r\n\r\n    <tbody>\r\n        {% for tax in doc.taxes %}\r\n        <tr style=\"border-bottom:0.5px solid #eaeaea;\">\r\n            <td style=\"padding:2px 4px; margin:0; text-align:left; color:#333333;\">\r\n                {{ tax.description }}\r\n            </td>\r\n            <td style=\"padding:2px 4px; margin:0; text-align:center; color:#333333;\">\r\n                {{ tax.rate }}%\r\n            </td>\r\n            <td style=\"padding:2px 4px; margin:0; text-align:right; color:#333333; white-space:nowrap;\">\r\n                {{ \"{:,.2f}\".format(tax.tax_amount) }} AED\r\n            </td>\r\n            <td style=\"padding:2px 4px; margin:0; text-align:right; color:#333333; white-space:nowrap;\">\r\n                {{ \"{:,.2f}\".format(tax.tax_amount) }} AED\r\n            </td>\r\n        </tr>\r\n        {% endfor %}\r\n\r\n        <tr style=\"background-color:#eef7f2; font-weight:bold;\">\r\n            <td style=\"padding:2px 4px; text-align:left;\">Total</td>\r\n            <td style=\"padding:2px 4px; text-align:center;\"></td>\r\n            <td style=\"padding:2px 4px; text-align:right; white-space:nowrap;\">\r\n                {{ \"{:,.2f}\".format(doc.total_taxes_and_charges) }} AED\r\n            </td>\r\n            <td style=\"padding:2px 4px; text-align:right; white-space:nowrap;\">\r\n                {{ \"{:,.2f}\".format(doc.total_taxes_and_charges) }} AED\r\n            </td>\r\n        </tr>\r\n    </tbody>\r\n</table>\r\n\r\n<div style=\"font-size:9px; font-weight:700; color:#000000; margin-top:8px; margin-bottom:30px;\">\r\n    Total Tax In Words: {{ frappe.utils.money_in_words(doc.total_taxes_and_charges, doc.currency) }}\r\n</div>\r\n\r\n<!-- TERMS & CONDITIONS SECTION -->\r\n<div style=\"font-size:9px; \">\r\n   {{doc.terms or \"\"}}\r\n</div>\r\n\r\n<!-- CUSTOM FOOTER -->\r\n<div id=\"footer-html\" class=\"visible-pdf\" style=\"width:100%; padding:0 10px;\">\r\n    <div style=\"border-top: 1.5px dashed #2f6b3c; margin-bottom: 8px; width: 100%;\"></div>\r\n    \r\n    <table style=\"width:100%; font-size:8px; border-collapse:collapse; line-height:1.3;\">\r\n        <tr>\r\n            <!-- PO Number Column -->\r\n            <td style=\"width:8%; padding:2px 0; vertical-align:top; border:none;\">\r\n                <span style=\"color:#555555; display:block;white-space:nowrap;\">PO Number</span>\r\n                <span style=\"font-weight:700; color:#000000;white-space:nowrap;\">{{ doc.name }}</span>\r\n            </td>\r\n            \r\n            <!-- Date Column -->\r\n            <td style=\"width:8%; padding:2px 0; vertical-align:top; border:none;\">\r\n                <span style=\"color:#555555; display:block;white-space:nowrap;\">Date</span>\r\n                <span style=\"font-weight:700; color:#000000;white-space:nowrap;\">{{ frappe.utils.formatdate(doc.transaction_date, \"dd MMM yyyy\") }}</span>\r\n            </td>\r\n            \r\n            <!-- Vendor Column -->\r\n            <td style=\"width:55%; padding:2px 0; vertical-align:top; border:none;\">\r\n                <span style=\"color:#555555; display:block;white-space:nowrap;\">Vendor</span>\r\n                <span style=\"font-weight:700; color:#000000;white-space:nowrap; text-transform:uppercase;\">{{ doc.supplier_name }}</span>\r\n            </td>\r\n            \r\n            <!-- Page Number Column -->\r\n            <td style=\"width:15%; padding:2px 0; vertical-align:middle; text-align:right; border:none; font-weight:700; color:#000000;\">\r\n                Page <span class=\"page\"></span> of <span class=\"topage\"></span>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n    \r\n    <div style=\"text-align:center; font-size:8px; color:#666666; margin-top:8px;\">\r\n        This is a computer-generated document and is deemed to be signed.\r\n    </div>\r\n</div>\r\n",
