 "doc_type": "LEAVE DECLARATION",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\r\n@page {\r\n    margin-top: 30px;\r\n}\r\n\r\n\r\n.print-format {\r\n    padding-top: 30px !important;\r\n}\r\n    .letter-head-footer {\r\n        margin: 0 !important;\r\n        padding: 0 !important;\r\n    }\r\n    @media screen {\r\n        .print-format {\r\n            width: 9.4in;\r\n            padding: 0.20in;\r\n            min-height: 11.7in;\r\n        }\r\n    }\r\n    .print-format p{\r\n        \r\n    margin:1px 0;\r\n    line-height:1.1;\r\n}\r\n</style>\r\n\r\n<div style=\"text-align:right; font-size:10px; margin-bottom:3px;\">\r\n    Doc Ref: {{ doc.name }}\r\n</div>\r\n\r\n<table style=\"width:100%; border-collapse:collapse; border:1px solid #000; font-family:Arial, Helvetica, sans-serif; font-size:11px;\">\r\n    <tr>\r\n        <td colspan=\"4\"\r\n            style=\"border:1px solid #000; text-align:center; font-weight:bold; font-size:16px; padding:6px 0;\">\r\n            EMPLOYEE CLEARANCE FORM\r\n        </td>\r\n    </tr>\r\n\r\n\r\n    <tr>\r\n        <td style=\"border:1px solid #000; width:25%; font-weight:bold;\">\r\n            Name of Employee\r\n        </td>\r\n        <td style=\"border:1px solid #000; width:25%; padding:6px 8px; color:#9A8700; font-weight:bold;\">\r\n           <center> {{ doc.employee_name }}</center>\r\n        </td>\r\n\r\n        <td style=\"border:1px solid #000; width:25%; font-weight:bold;\">\r\n            Staff ID No.\r\n        </td>\r\n        <td style=\"border:1px solid #000; width:25%; padding:6px 8px; text-align:center; font-weight:bold;\">\r\n            {{ doc.employee }}\r\n        </td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td style=\"border:1px solid #000; font-weight:bold; padding:6px 8px;\">\r\n            Designation\r\n        </td>\r\n        <td style=\"border:1px solid #000; padding:6px 8px; text-align:center; color:#9A8700; font-weight:bold;\">\r\n            {{ doc.designation }}\r\n        </td>\r\n\r\n        <td style=\"border:1px solid #000; font-weight:bold; padding:6px 8px;\">\r\n            Type of Clearance\r\n        </td>\r\n        <td style=\"border:1px solid #000; padding:6px 8px; text-align:center; color:#9A8700; font-weight:bold;\">\r\n            {{ doc.leave_type }}\r\n        </td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td style=\"border:1px solid #000; font-weight:bold; padding:6px 8px;\">\r\n            Department / Location\r\n        </td>\r\n        <td style=\"border:1px solid #000; padding:6px 8px; text-align:center; color:#9A8700; font-weight:bold;\">\r\n            {{ frappe.db.get_value(\"Employee\", doc.employee, \"department\") or \"\" }}\r\n        </td>\r\n\r\n        <td style=\"border:1px solid #000; font-weight:bold; padding:6px 8px;\">\r\n            Last Working Date\r\n        </td>\r\n        <td style=\"border:1px solid #000; padding:6px 8px; text-align:center; color:#9A8700; font-weight:bold;\">\r\n            {{ doc.get_formatted(\"leaving_date\") }}\r\n        </td>\r\n    </tr>\r\n<tr>\r\n    <td colspan=\"4\"\r\n        style=\"\r\n            background:#404429;\r\n            border:1px solid #000;\r\n            height:18px;\r\n            padding:0;\r\n            line-height:18px;\">\r\n    </td>\r\n</tr>\r\n<tr>\r\n    <td style=\"border:1px solid #7b7b4b;background:#404429;color:#fff;font-weight:bold;text-align:center;padding:5px;width:25%;\">\r\n        DEPARTMENT\r\n    </td>\r\n\r\n    <td style=\"border:1px solid #7b7b4b;background:#404429;color:#fff;font-weight:bold;text-align:center;padding:5px;width:25%;\">\r\n        PARTICULARS\r\n    </td>\r\n\r\n    <td style=\"border:1px solid #7b7b4b;background:#404429;color:#fff;font-weight:bold;text-align:center;padding:5px;width:25%;\">\r\n        REMARKS\r\n    </td>\r\n\r\n    <td style=\"border:1px solid #7b7b4b;background:#404429;color:#fff;font-weight:bold;text-align:center;padding:5px;width:25%;\">\r\n        Signature\r\n    </td>\r\n</tr>\r\n\r\n<!-- ================= HRD ================= -->\r\n\r\n<tr>\r\n    <td rowspan=\"2\" style=\"border:1px solid #7b7b4b;font-weight:bold;padding:6px;vertical-align:top;\">\r\n        HRD\r\n    </td>\r\n\r\n    <td style=\"border:1px solid #7b7b4b;padding:6px;\">\r\n        Outstanding Advance\r\n    </td>\r\n\r\n    <td style=\"border:1px solid #7b7b4b;padding:6px;color:#1d2fa3;font-weight:bold;\">\r\n        {% if doc.outstanding_advance %}\r\n            {{ doc.get_formatted(\"outstanding_advance\") }}\r\n        {% else %}\r\n            NIL\r\n        {% endif %}\r\n    </td>\r\n\r\n    <td rowspan=\"2\" style=\"border:1px solid #7b7b4b;\"></td>\r\n</tr>\r\n\r\n<tr>\r\n    <td style=\"border:1px solid #7b7b4b;padding:6px;\">\r\n        Others\r\n    </td>\r\n\r\n    <td style=\"border:1px solid #7b7b4b;padding:6px;\">\r\n        {{ doc.hr_remarks or \"\" }}\r\n    </td>\r\n</tr>\r\n\r\n<!-- ================= PRO ================= -->\r\n\r\n<tr>\r\n    <td rowspan=\"3\" style=\"border:1px solid #7b7b4b;font-weight:bold;padding:6px;vertical-align:top;\">\r\n        PRO\r\n    </td>\r\n\r\n    <td style=\"border:1px solid #7b7b4b;padding:6px;\">\r\n        Passport Expiry\r\n    </td>\r\n\r\n    <td style=\"border:1px solid #7b7b4b;padding:6px;color:#1d2fa3;font-weight:bold;\">\r\n        {{ doc.passport_number or \"\" }}\r\n    </td>\r\n\r\n    <td rowspan=\"3\" style=\"border:1px solid #7b7b4b;\"></td>\r\n</tr>\r\n\r\n<tr>\r\n    <td style=\"border:1px solid #7b7b4b;padding:6px;\">\r\n        Work Permit Expiry\r\n    </td>\r\n\r\n    <td style=\"border:1px solid #7b7b4b;padding:6px;\">\r\n        {{ doc.work_permit_expiry or \"\" }}\r\n    </td>\r\n</tr>\r\n\r\n<tr>\r\n    <td style=\"border:1px solid #7b7b4b;padding:6px;\">\r\n        Residency Expiry\r\n    </td>\r\n\r\n    <td style=\"border:1px solid #7b7b4b;padding:6px;\">\r\n        {{ doc.residency_expiry or \"\" }}\r\n    </td>\r\n</tr>\r\n\r\n<!-- ================= CAMP ================= -->\r\n\r\n<tr>\r\n    <td rowspan=\"2\" style=\"border:1px solid #7b7b4b;font-weight:bold;padding:6px;vertical-align:top;\">\r\n        CAMP\r\n    </td>\r\n\r\n    <td style=\"border:1px solid #7b7b4b;padding:6px;\">\r\n        Accommodation Clearance\r\n    </td>\r\n\r\n    <td style=\"border:1px solid #7b7b4b;padding:6px;color:#1d2fa3;font-weight:bold;\">\r\n        {{ doc.accommodation_clearances or \"\" }}\r\n    </td>\r\n\r\n    <td rowspan=\"2\" style=\"border:1px solid #7b7b4b;\"></td>\r\n</tr>\r\n\r\n<tr>\r\n    <td style=\"border:1px solid #7b7b4b;padding:6px;\">\r\n        Uniform\r\n    </td>\r\n\r\n    <td style=\"border:1px solid #7b7b4b;padding:6px;color:#1d2fa3;font-weight:bold;\">\r\n        {{ doc.uniform or \"\" }}\r\n    </td>\r\n</tr>\r\n\r\n<!-- ================= TRANSPORT ================= -->\r\n\r\n<tr>\r\n    <td rowspan=\"3\" style=\"border:1px solid #7b7b4b;font-weight:bold;padding:6px;vertical-align:top;\">\r\n        TRANSPORT\r\n    </td>\r\n\r\n    <td style=\"border:1px solid #7b7b4b;padding:6px;\">\r\n        Vehicle Fines\r\n    </td>\r\n\r\n    <td style=\"border:1px solid #7b7b4b;padding:6px;\">\r\n\r\n        {% if doc.vehicle_fine %}\r\n\r\n            <span style=\"color:#1d2fa3;font-weight:bold;\">\r\n                {{ doc.get_formatted(\"vehicle_fine\") }}\r\n            </span>\r\n\r\n        {% else %}\r\n\r\n            <span style=\"background:#fff59d;padding:1px 6px;font-weight:bold;\">\r\n                NO FINES\r\n            </span>\r\n\r\n        {% endif %}\r\n\r\n    </td>\r\n\r\n    <td rowspan=\"3\" style=\"border:1px solid #7b7b4b;\"></td>\r\n</tr>\r\n\r\n<tr>\r\n    <td style=\"border:1px solid #7b7b4b;padding:6px;\">\r\n        Vehicle Handover\r\n    </td>\r\n\r\n    <td style=\"border:1px solid #7b7b4b;padding:6px;\">\r\n\r\n        {% if doc.vehicle_handover %}\r\n\r\n            {{ doc.vehicle_handover }}\r\n\r\n        {% else %}\r\n\r\n            <span style=\"background:#fff59d;padding:1px 6px;font-weight:bold;\">\r\n                NO REPLACEMENT\r\n            </span>\r\n\r\n        {% endif %}\r\n\r\n    </td>\r\n</tr>\r\n\r\n<tr>\r\n    <td style=\"border:1px solid #7b7b4b;padding:6px;\">\r\n        Others\r\n    </td>\r\n\r\n    <td style=\"border:1px solid #7b7b4b;padding:6px;\">\r\n        {{ doc.transport_remarks or \"\" }}\r\n    </td>\r\n</tr>\r\n<!-- ================= ADMINISTRATION ================= -->\r\n\r\n<tr>\r\n\r\n<td rowspan=\"5\" style=\"border:1px solid #7b7b4b;font-weight:bold;vertical-align:top;padding:6px;\">\r\nADMINISTRATION\r\n</td>\r\n\r\n<td style=\"border:1px solid #7b7b4b;padding:6px;\">\r\nMobile Handset &amp; Accessories\r\n</td>\r\n\r\n<td style=\"border:1px solid #7b7b4b;padding:6px;\">\r\n\r\n{% set ns = namespace(found=false) %}\r\n\r\n{% for row in doc.asset_clearance_detail %}\r\n    {% if \"mobile\" in (row.asset_type or \"\")|lower or \"phone\" in (row.asset_type or \"\")|lower %}\r\n        {{ row.brand or \"\" }} {{ row.model or \"\" }}\r\n        {% if row.remarks %}- {{ row.remarks }}{% endif %}\r\n        {% set ns.found = true %}\r\n    {% endif %}\r\n{% endfor %}\r\n\r\n{% if not ns.found %}\r\n<span style=\"background:#fff59d;padding:1px 8px;font-weight:bold;\">N/A</span>\r\n{% endif %}\r\n\r\n</td>\r\n\r\n<td rowspan=\"5\" style=\"border:1px solid #7b7b4b;\"></td>\r\n\r\n</tr>\r\n\r\n<tr>\r\n\r\n<td style=\"border:1px solid #7b7b4b;padding:6px;\">\r\nLaptop &amp; Accessories\r\n</td>\r\n\r\n<td style=\"border:1px solid #7b7b4b;padding:6px;\">\r\n\r\n{% set ns = namespace(found=false) %}\r\n\r\n{% for row in doc.asset_clearance_detail %}\r\n{% if \"laptop\" in (row.asset_type or \"\")|lower %}\r\n{{ row.asset_code or \"\" }}\r\n{% set ns.found=true %}\r\n{% endif %}\r\n{% endfor %}\r\n\r\n{% if not ns.found %}\r\n<span style=\"background:#fff59d;padding:1px 8px;font-weight:bold;\">N/A</span>\r\n{% endif %}\r\n\r\n</td>\r\n\r\n</tr>\r\n\r\n<tr>\r\n\r\n<td style=\"border:1px solid #7b7b4b;padding:6px;\">\r\nEmail &amp; Mobile Number\r\n</td>\r\n\r\n<td style=\"border:1px solid #7b7b4b;padding:6px;\">\r\n\r\n{% if doc.employee_email %}\r\n{{ doc.employee_email }}\r\n{% else %}\r\n<span style=\"background:#fff59d;padding:1px 8px;font-weight:bold;\">N/A</span>\r\n{% endif %}\r\n\r\n</td>\r\n\r\n</tr>\r\n\r\n<tr>\r\n\r\n<td style=\"border:1px solid #7b7b4b;padding:6px;\">\r\nOffice Access Card\r\n</td>\r\n\r\n<td style=\"border:1px solid #7b7b4b;padding:6px;\">\r\n\r\n{% if doc.access_card_detail %}\r\n{% for row in doc.access_card_detail %}\r\n{{ row.access_card_name }}{% if not loop.last %}, {% endif %}\r\n{% endfor %}\r\n{% else %}\r\n<span style=\"background:#fff59d;padding:1px 8px;font-weight:bold;\">N/A</span>\r\n{% endif %}\r\n\r\n</td>\r\n\r\n</tr>\r\n\r\n<tr>\r\n\r\n<td style=\"border:1px solid #7b7b4b;padding:6px;\">\r\nOthers\r\n</td>\r\n\r\n<td style=\"border:1px solid #7b7b4b;padding:6px;\">\r\n&nbsp;\r\n</td>\r\n\r\n</tr>\r\n\r\n<!-- ================= OPERATIONS ================= -->\r\n\r\n<tr>\r\n\r\n<td rowspan=\"3\" style=\"border:1px solid #7b7b4b;font-weight:bold;vertical-align:top;padding:6px;\">\r\nOPERATIONS\r\n</td>\r\n\r\n<td style=\"border:1px solid #7b7b4b;padding:6px;\">\r\n\r\n<strong>Access Cards:</strong>\r\n\r\n<ol type=\"a\" style=\"margin:4px 0 0 18px;padding:0;\">\r\n\r\n{% for row in doc.access_card_detail %}\r\n<li>{{ row.access_card_name }}</li>\r\n{% endfor %}\r\n\r\n</ol>\r\n\r\n</td>\r\n\r\n<td style=\"border:1px solid #7b7b4b;padding:6px;color:#1d2fa3;vertical-align:top;\">\r\n\r\n{% for row in doc.access_card_detail %}\r\n{{ row.remarks or \"In the office\" }}<br>\r\n{% endfor %}\r\n\r\n</td>\r\n\r\n<td rowspan=\"3\" style=\"border:1px solid #7b7b4b;vertical-align:middle;text-align:center;\">\r\n</td>\r\n\r\n</tr>\r\n\r\n<tr>\r\n\r\n<td style=\"border:1px solid #7b7b4b;padding:6px;\">\r\n<strong>Site Asset Handover</strong>\r\n</td>\r\n\r\n<td style=\"border:1px solid #7b7b4b;padding:6px;\">\r\n\r\n{% set ns = namespace(found=false) %}\r\n\r\n{% for row in doc.asset_clearance_detail %}\r\n{% if \"site\" in (row.asset_type or \"\")|lower %}\r\n{{ row.asset_type }}\r\n{% set ns.found=true %}\r\n{% endif %}\r\n{% endfor %}\r\n\r\n{% if not ns.found %}\r\n&nbsp;\r\n{% endif %}\r\n\r\n</td>\r\n\r\n</tr>\r\n\r\n<tr>\r\n\r\n<td style=\"border:1px solid #7b7b4b;padding:6px;\">\r\nOthers\r\n</td>\r\n\r\n<td style=\"border:1px solid #7b7b4b;padding:6px;\">\r\n&nbsp;\r\n</td>\r\n\r\n</tr>\r\n\r\n<!-- ================= SALARIES ================= -->\r\n\r\n<tr>\r\n    <td colspan=\"4\"\r\n        style=\"border:1px solid #7b7b4b;padding:6px 8px;font-size:12px;line-height:1.3;vertical-align:top;\">\r\n\r\n        <strong>Salaries:</strong><br>\r\n\r\n        {% if doc.salary_detail %}\r\n\r\n            {% for row in doc.salary_detail %}\r\n\r\n                {% if loop.first %}\r\n\r\n                    <strong>{{ (row.month or \"\")|upper }} SALARY</strong>\r\n\r\n                {% else %}\r\n\r\n                    <strong>SALARY MONTH OF {{ (row.month or \"\")|upper }} WITHOUT OT</strong>\r\n\r\n                {% endif %}\r\n\r\n                : {{ row.get_formatted(\"amount\") }}/-\r\n\r\n                {% if not loop.last %}\r\n                    <br>\r\n                {% endif %}\r\n\r\n            {% endfor %}\r\n\r\n        {% else %}\r\n\r\n            N/A\r\n\r\n        {% endif %}\r\n\r\n    </td>\r\n</tr>\r\n\r\n<!-- ================= ACCOUNTS CLEARANCE ================= -->\r\n\r\n<tr>\r\n\r\n    <td colspan=\"4\"\r\n        style=\"border:1px solid #7b7b4b;padding:6px;height:32px;vertical-align:top;\">\r\n\r\n        Accounts Clearance\r\n\r\n    </td>\r\n\r\n</tr>\r\n\r\n<!-- ================= LINE MANAGER ================= -->\r\n\r\n{% set manager = frappe.db.get_value(\"Employee\", doc.employee, \"reports_to\") %}\r\n{% set manager_name = frappe.db.get_value(\"Employee\", manager, \"employee_name\") if manager else \"\" %}\r\n<tr>\r\n    <td colspan=\"4\"\r\n        style=\"border:1px solid #7b7b4b;padding:6px;height:55px;vertical-align:top;\">\r\n\r\n        <strong>Line Manager Signature:</strong><br>\r\n\r\n        {{ manager_name }}\r\n\r\n    </td>\r\n</tr>\r\n\r\n<!-- ================= APPROVAL HEADER ================= -->\r\n\r\n<tr>\r\n    <td colspan=\"4\" style=\"padding:0; border:none;\">\r\n        <table style=\"width:100%; border-collapse:separate; border-spacing:8px 0; table-layout:fixed;\">\r\n            <tr>\r\n                <td style=\"width:33.33%; background:#404429; color:#fff; text-align:center; font-weight:bold; padding:5px; border:1px solid #7b7b4b;\">\r\n                    HEAD OF DEPARTMENT\r\n                </td>\r\n\r\n                <td style=\"width:33.33%; background:#404429; color:#fff; text-align:center; font-weight:bold; padding:5px; border:1px solid #7b7b4b;\">\r\n                    HR DEPARTMENT\r\n                </td>\r\n\r\n                <td style=\"width:33.33%; background:#404429; color:#fff; text-align:center; font-weight:bold; padding:5px; border:1px solid #7b7b4b;\">\r\n                    MANAGEMENT\r\n                </td>\r\n            </tr>\r\n\r\n            <tr>\r\n                <td style=\"height:80px; border:1px solid #7b7b4b;\"></td>\r\n                <td style=\"height:80px; border:1px solid #7b7b4b;\"></td>\r\n                <td style=\"height:80px; border:1px solid #7b7b4b;\"></td>\r\n            </tr>\r\n        </table>\r\n    </td>\r\n</tr>",
