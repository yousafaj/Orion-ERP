 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\r\n@page {\r\n    margin: 15px;\r\n}\r\n\r\n.print-format {\r\n    padding: 0 !important;\r\n}\r\n\r\n.letter-head-footer {\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n}\r\n\r\n@media screen {\r\n    .print-format {\r\n        width: 9.4in;\r\n        padding: 0.20in;\r\n        min-height: 11.7in;\r\n    }\r\n}\r\n\r\n.print-format p {\r\n    margin: 1px 0;\r\n    line-height: 1.2;\r\n}\r\n\r\ntable.cf {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    table-layout: fixed;\r\n    font-family: Arial, Helvetica, sans-serif;\r\n    font-size: 11px;\r\n    line-height: 1.2;\r\n    border: 1px solid #000;\r\n}\r\n\r\ntable.cf td {\r\n    word-wrap: break-word;\r\n    overflow-wrap: break-word;\r\n}\r\n\r\ntable.cf > tbody.kp {\r\n    page-break-inside: avoid;\r\n    break-inside: avoid;\r\n}\r\n\r\ntable.cf-ap {\r\n    width: 100%;\r\n    border-collapse: separate;\r\n    border-spacing: 8px 0;\r\n    table-layout: fixed;\r\n}\r\n\r\ntable.cf-ap td {\r\n    border: 1px solid #7b7b4b;\r\n}\r\n</style>\r\n\r\n<div style=\"text-align:right; font-size:10px; margin-bottom:3px;\">\r\n    Doc Ref: {{ doc.name }}\r\n</div>\r\n\r\n{% set emp = frappe.get_doc(\"Employee\", doc.employee) %}\r\n{% set manager = frappe.db.get_value(\"Employee\", doc.employee, \"reports_to\") %}\r\n{% set manager_name = frappe.db.get_value(\"Employee\", manager, \"employee_name\") if manager else \"\" %}\r\n\r\n<table class=\"cf\">\r\n\r\n<!-- ===== HEADER ===== -->\r\n<tbody class=\"kp\">\r\n<tr>\r\n    <td colspan=\"4\" style=\"border:1px solid #000; text-align:center; font-weight:bold; font-size:16px; padding:6px;\">\r\n        EMPLOYEE CLEARANCE FORM\r\n    </td>\r\n</tr>\r\n<tr>\r\n    <td style=\"border:1px solid #000; width:25%; font-weight:bold; padding:5px 6px;\">Name of Employee</td>\r\n    <td style=\"border:1px solid #000; width:25%; padding:6px 8px; text-align:center; color:#9A8700; font-weight:bold;\">\r\n        <center>{{ doc.employee_name }}</center>\r\n    </td>\r\n    <td style=\"border:1px solid #000; width:25%; font-weight:bold; padding:5px 6px;\">Staff ID No.</td>\r\n    <td style=\"border:1px solid #000; width:25%; padding:6px 8px; text-align:center; font-weight:bold; color:#9A8700;\">\r\n        {{ doc.employee }}\r\n    </td>\r\n</tr>\r\n<tr>\r\n    <td style=\"border:1px solid #000; width:25%; font-weight:bold; padding:5px 6px;\">Designation</td>\r\n    <td style=\"border:1px solid #000; width:25%; padding:6px 8px; text-align:center; color:#9A8700; font-weight:bold;\">\r\n        {{ doc.designation }}\r\n    </td>\r\n    <td style=\"border:1px solid #000; width:25%; font-weight:bold; padding:5px 6px;\">Type of Clearance</td>\r\n    <td style=\"border:1px solid #000; width:25%; padding:6px 8px; text-align:center; font-weight:bold; color:#9A8700;\">\r\n        {{ doc.type_of_clearance }}\r\n    </td>\r\n</tr>\r\n<tr>\r\n    <td style=\"border:1px solid #000; width:25%; font-weight:bold; padding:5px 6px;\">Department / Location</td>\r\n    <td style=\"border:1px solid #000; width:25%; padding:6px 8px; text-align:center; color:#9A8700; font-weight:bold;\">\r\n        {{ emp.custom_department_of_working_company or \"\" }}\r\n    </td>\r\n    <td style=\"border:1px solid #000; width:25%; font-weight:bold; padding:5px 6px;\">Last Working Date</td>\r\n    <td style=\"border:1px solid #000; width:25%; padding:6px 8px; text-align:center; font-weight:bold; color:#9A8700;\">\r\n        {{ doc.get_formatted(\"leaving_date\") }}\r\n    </td>\r\n</tr>\r\n<tr>\r\n    <td colspan=\"4\" style=\"background:#404429; border:1px solid #7b7b4b; height:8px; padding:0; font-size:1px;\">&nbsp;</td>\r\n</tr>\r\n<tr>\r\n    <td colspan=\"4\" style=\"border:1px solid #7b7b4b; height:6px; padding:0; font-size:1px;\">&nbsp;</td>\r\n</tr>\r\n<tr>\r\n    <td style=\"background:#404429; color:#fff; font-weight:bold; text-align:center; padding:5px; border:1px solid #7b7b4b; width:25%;\">DEPARTMENT</td>\r\n    <td style=\"background:#404429; color:#fff; font-weight:bold; text-align:center; padding:5px; border:1px solid #7b7b4b; width:25%;\">PARTICULARS</td>\r\n    <td style=\"background:#404429; color:#fff; font-weight:bold; text-align:center; padding:5px; border:1px solid #7b7b4b; width:25%;\">REMARKS</td>\r\n    <td style=\"background:#404429; color:#fff; font-weight:bold; text-align:center; padding:5px; border:1px solid #7b7b4b; width:25%;\">Signature</td>\r\n</tr>\r\n</tbody>\r\n\r\n<!-- ===== HRD ===== -->\r\n<tbody class=\"kp\">\r\n<tr>\r\n    <td rowspan=\"2\" style=\"border:1px solid #7b7b4b; font-weight:bold; padding:5px 6px; width:25%; vertical-align:top;\">HRD</td>\r\n    <td style=\"border:1px solid #7b7b4b; padding:5px 6px; width:25%;\">Outstanding Advance</td>\r\n    <td style=\"border:1px solid #7b7b4b; padding:5px 6px; width:25%; text-align:center;\">\r\n        {% if doc.outstanding_advance %}{{ doc.get_formatted(\"outstanding_advance\") }}{% else %}NIL{% endif %}\r\n    </td>\r\n    <td rowspan=\"2\" style=\"border:1px solid #7b7b4b; width:25%;\"></td>\r\n</tr>\r\n<tr>\r\n    <td style=\"border:1px solid #7b7b4b; padding:5px 6px; width:25%;\">Others</td>\r\n    <td style=\"border:1px solid #7b7b4b; padding:5px 6px; width:25%; text-align:center;\">{{ doc.hrd_other_details or \"\" }}</td>\r\n</tr>\r\n</tbody>\r\n\r\n<!-- ===== PRO ===== -->\r\n<tbody class=\"kp\">\r\n<tr>\r\n    <td rowspan=\"3\" style=\"border:1px solid #7b7b4b; font-weight:bold; padding:5px 6px; width:25%; vertical-align:top;\">PRO</td>\r\n    <td style=\"border:1px solid #7b7b4b; padding:5px 6px; width:25%;\">Passport Expiry</td>\r\n    <td style=\"border:1px solid #7b7b4b; padding:5px 6px; width:25%; text-align:center;\">\r\n        {% for row in emp.custom_certificates %}{% if row.certification_name == \"Passport No\" %}{{ frappe.format_value(row.date_of_expiry, {\"fieldtype\":\"Date\"}) }}{% endif %}{% endfor %}\r\n    </td>\r\n    <td rowspan=\"3\" style=\"border:1px solid #7b7b4b; width:25%;\"></td>\r\n</tr>\r\n<tr>\r\n    <td style=\"border:1px solid #7b7b4b; padding:5px 6px; width:25%;\">Work Permit Expiry</td>\r\n    <td style=\"border:1px solid #7b7b4b; padding:5px 6px; width:25%; text-align:center;\">\r\n        {% for row in emp.custom_certificates %}{% if row.certification_name == \"Work Permit\" %}{{ frappe.format_value(row.date_of_expiry, {\"fieldtype\":\"Date\"}) }}{% endif %}{% endfor %}\r\n    </td>\r\n</tr>\r\n<tr>\r\n    <td style=\"border:1px solid #7b7b4b; padding:5px 6px; width:25%;\">Residency Expiry</td>\r\n    <td style=\"border:1px solid #7b7b4b; padding:5px 6px; width:25%; text-align:center;\">\r\n        {% for row in emp.custom_certificates %}{% if row.certification_name == \"Residence Permit\" %}{{ frappe.format_value(row.date_of_expiry, {\"fieldtype\":\"Date\"}) }}{% endif %}{% endfor %}\r\n    </td>\r\n</tr>\r\n</tbody>\r\n\r\n<!-- ===== CAMP ===== -->\r\n<tbody class=\"kp\">\r\n<tr>\r\n    <td rowspan=\"2\" style=\"border:1px solid #7b7b4b; font-weight:bold; padding:5px 6px; width:25%; vertical-align:top;\">CAMP</td>\r\n    <td style=\"border:1px solid #7b7b4b; padding:5px 6px; width:25%;\">Accommodation Clearance</td>\r\n    <td style=\"border:1px solid #7b7b4b; padding:5px 6px; width:25%; text-align:center;\">{{ doc.accommodation_clearances or \"\" }}</td>\r\n    <td rowspan=\"2\" style=\"border:1px solid #7b7b4b; width:25%;\"></td>\r\n</tr>\r\n<tr>\r\n    <td style=\"border:1px solid #7b7b4b; padding:5px 6px; width:25%;\">Uniform</td>\r\n    <td style=\"border:1px solid #7b7b4b; padding:5px 6px; width:25%; text-align:center;\">{{ doc.uniform or \"\" }}</td>\r\n</tr>\r\n</tbody>\r\n\r\n<!-- ===== TRANSPORT ===== -->\r\n<tbody class=\"kp\">\r\n<tr>\r\n    <td rowspan=\"3\" style=\"border:1px solid #7b7b4b; font-weight:bold; padding:5px 6px; width:25%; vertical-align:top;\">TRANSPORT</td>\r\n    <td style=\"border:1px solid #7b7b4b; padding:5px 6px; width:25%;\">Vehicle Fines</td>\r\n    <td style=\"border:1px solid #7b7b4b; padding:5px 6px; width:25%; text-align:center;\">\r\n        {% if doc.vehicle_fine %}{{ doc.get_formatted(\"vehicle_fine\") }}{% else %}NO FINES{% endif %}\r\n    </td>\r\n    <td rowspan=\"3\" style=\"border:1px solid #7b7b4b; width:25%;\"></td>\r\n</tr>\r\n<tr>\r\n    <td style=\"border:1px solid #7b7b4b; padding:5px 6px; width:25%;\">Vehicle Handover</td>\r\n    <td style=\"border:1px solid #7b7b4b; padding:5px 6px; width:25%; text-align:center;\">\r\n        {% if doc.vehicle_handover %}{{ doc.vehicle_handover }}{% else %}NO REPLACEMENT{% endif %}\r\n    </td>\r\n</tr>\r\n<tr>\r\n    <td style=\"border:1px solid #7b7b4b; padding:5px 6px; width:25%;\">Others</td>\r\n    <td style=\"border:1px solid #7b7b4b; padding:5px 6px; width:25%; text-align:center;\">{{ doc.transport_other_detail or \"\" }}</td>\r\n</tr>\r\n</tbody>\r\n\r\n<!-- ===== ADMINISTRATION ===== -->\r\n{% set total_rows = (doc.asset_clearance_detail|length) + 1 %}\r\n<tbody>\r\n{% for row in doc.asset_clearance_detail %}\r\n<tr>\r\n    {% if loop.first %}<td rowspan=\"{{ total_rows }}\" style=\"border:1px solid #7b7b4b; font-weight:bold; padding:5px 6px; width:25%; vertical-align:top;\">ADMINISTRATION</td>{% endif %}\r\n    <td style=\"border:1px solid #7b7b4b; padding:5px 6px; width:25%;\">{{ row.asset_type }}</td>\r\n    <td style=\"border:1px solid #7b7b4b; padding:5px 6px; width:25%; text-align:center;\">{{ row.asset_code or \"\" }}</td>\r\n    {% if loop.first %}<td rowspan=\"{{ total_rows }}\" style=\"border:1px solid #7b7b4b; width:25%;\"></td>{% endif %}\r\n</tr>\r\n{% endfor %}\r\n<tr>\r\n    <td style=\"border:1px solid #7b7b4b; padding:5px 6px; width:25%;\">Others</td>\r\n    <td style=\"border:1px solid #7b7b4b; padding:5px 6px; width:25%; text-align:center;\">{{ doc.administration_other_detail or \"\" }}</td>\r\n   \r\n</tr>\r\n</tbody>\r\n\r\n<!-- ===== OPERATIONS ===== -->\r\n{% set total_rows = (doc.access_card_detail|length) + 3 %}\r\n<tbody>\r\n<tr>\r\n    <td rowspan=\"{{ total_rows }}\" style=\"border:1px solid #7b7b4b; font-weight:bold; padding:5px 6px; width:25%; vertical-align:top;\">OPERATIONS</td>\r\n    <td style=\"border:1px solid #7b7b4b; padding:5px 6px; width:25%; font-weight:bold;\">Access cards:</td>\r\n    <td style=\"border:1px solid #7b7b4b; padding:5px 6px; width:25%;\"></td>\r\n    <td rowspan=\"{{ total_rows }}\" style=\"border:1px solid #7b7b4b; width:25%;\"></td>\r\n</tr>\r\n{% for row in doc.access_card_detail %}\r\n<tr>\r\n    <td style=\"border:1px solid #7b7b4b; padding:5px 6px; width:25%;\">{{ \"abcdefghijklmnopqrstuvwxyz\"[loop.index0] }}) {{ row.access_card_name }}</td>\r\n    <td style=\"border:1px solid #7b7b4b; padding:5px 6px; width:25%; text-align:center;\">{{ row.details or \"In the office\" }}</td>\r\n</tr>\r\n{% endfor %}\r\n<tr>\r\n    <td style=\"border:1px solid #7b7b4b; padding:5px 6px; width:25%; font-weight:bold;\">Site asset handover</td>\r\n    <td style=\"border:1px solid #7b7b4b; padding:5px 6px; width:25%;\"></td>\r\n   \r\n</tr>\r\n<tr>\r\n    <td style=\"border:1px solid #7b7b4b; padding:5px 6px; width:25%; font-weight:bold;\">Others:</td>\r\n    <td style=\"border:1px solid #7b7b4b; padding:5px 6px; width:25%; text-align:center;\">{{ doc.operations_other_details or \"\" }}</td>\r\n    \r\n</tr>\r\n</tbody>\r\n\r\n<!-- ===== SALARIES ===== -->\r\n<tr>\r\n    <td colspan=\"4\" style=\"border:1px solid #7b7b4b; padding:6px 8px; font-size:12px; line-height:1.4; vertical-align:top;\">\r\n        <strong>Salaries:</strong><br>\r\n        {% if doc.salary_detail %}\r\n        {% for row in doc.salary_detail %}\r\n        <strong>{{ (row.month or \"\")|upper }} SALARY {{ row.type or \"\" }}</strong>: {{ row.get_formatted(\"amount\") }}/-{% if not loop.last %}<br>{% endif %}\r\n        {% endfor %}\r\n        {% else %}N/A{% endif %}\r\n    </td>\r\n</tr>\r\n\r\n<!-- ===== ACCOUNTS CLEARANCE ===== -->\r\n<tr>\r\n    <td colspan=\"4\" style=\"border:1px solid #7b7b4b; padding:6px 8px; height:32px; vertical-align:top;\">\r\n        Accounts Clearance\r\n    </td>\r\n</tr>\r\n\r\n<!-- ===== LINE MANAGER ===== -->\r\n<tr>\r\n    <td colspan=\"4\" style=\"border:1px solid #7b7b4b; padding:6px 8px; height:55px; vertical-align:top;\">\r\n        <strong>Line Manager Signature:</strong><br>\r\n        {{ manager_name }}\r\n    </td>\r\n</tr>\r\n\r\n<!-- ===== APPROVAL SIGNATURES ===== -->\r\n<tr>\r\n    <td colspan=\"4\" style=\"padding:8px 0; border:none;\">\r\n        <table class=\"cf-ap\">\r\n            <tr>\r\n                <td style=\"width:33.33%; background:#404429; color:#fff; text-align:center; font-weight:bold; padding:5px;\">HEAD OF DEPARTMENT</td>\r\n                <td style=\"width:33.33%; background:#404429; color:#fff; text-align:center; font-weight:bold; padding:5px;\">HR DEPARTMENT</td>\r\n                <td style=\"width:33.33%; background:#404429; color:#fff; text-align:center; font-weight:bold; padding:5px;\">MANAGEMENT</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"height:80px; vertical-align:top;\"></td>\r\n                <td style=\"height:80px; vertical-align:top;\"></td>\r\n                <td style=\"height:80px; vertical-align:top;\"></td>\r\n            </tr>\r\n        </table>\r\n    </td>\r\n</tr>\r\n\r\n</table>",
