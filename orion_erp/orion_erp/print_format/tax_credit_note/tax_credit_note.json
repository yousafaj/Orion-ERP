 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\r\n@page {\r\n    margin-top: 30px;\r\n}\r\n\r\n\r\n.header-table{\r\n    width:100%;\r\n}\r\n\r\n.logo{\r\n    font-size:12px;\r\n    font-weight:bold;\r\n    color:#2f6b3c;\r\n}\r\n.print-format {\r\n    padding-top: 30px !important;\r\n}\r\n    .letter-head-footer {\r\n        margin: 0 !important;\r\n        padding: 0 !important;\r\n    }\r\n    @media screen {\r\n        .print-format {\r\n            width: 9.4in;\r\n            padding: 0.20in;\r\n            min-height: 11.7in;\r\n        }\r\n    }\r\n    .print-format p{\r\n        \r\n    margin:1px 0;\r\n    line-height:1.1;\r\n}\r\n\r\n.print-format td{\r\n    line-height:1.1;\r\n}\r\nbody {\r\n    margin:0 !important;\r\n    padding:0 !important;\r\n}\r\n\r\n.print-format table{\r\n    width:100%;\r\n    border-collapse:collapse;\r\n}\r\n\r\n.heading-green{\r\n    background:#2f7d4d;\r\n    color:#fff;\r\n}\r\n\r\n.heading-green th{\r\n    padding:10px;\r\n    color:white;\r\n    font-weight:bold;\r\n    border:none;\r\n}\r\n\r\n.item-table td{\r\n    padding:10px;\r\n    border-bottom:1px solid #ddd;\r\n    vertical-align:top;\r\n}\r\n\r\n.tax-summary th{\r\n    background:#dfe9e3;\r\n    color:#246a46;\r\n    padding:8px;\r\n    border:1px solid #cfd8d3;\r\n}\r\n\r\n.tax-summary td{\r\n    padding:8px;\r\n    border:1px solid #cfd8d3;\r\n}\r\n\r\n.total-box{\r\n    background:#2f7d4d;\r\n    color:#fff;\r\n    font-weight:bold;\r\n}\r\n\r\n.right{\r\n    text-align:right;\r\n}\r\n\r\n.center{\r\n    text-align:center;\r\n}\r\n\r\n.small{\r\n    font-size:10px;\r\n}\r\n\r\n</style>\r\n{% if doc.is_return %}\r\n{% set company_address = frappe.db.sql(\"\"\"\r\nSELECT\r\na.address_line1,\r\na.address_line2,\r\na.city,\r\na.state,\r\na.country,\r\na.phone,\r\na.email_id\r\nFROM `tabAddress` a\r\nINNER JOIN `tabDynamic Link` l\r\nON l.parent=a.name\r\nWHERE l.link_doctype='Company'\r\nAND l.link_name=%s\r\nLIMIT 1\r\n\"\"\",(doc.company,),as_dict=1) %}\r\n\r\n{% set customer_address = frappe.db.get_value(\r\n\"Address\",\r\ndoc.customer_address,\r\n[\r\n\"address_line1\",\r\n\"address_line2\",\r\n\"city\",\r\n\"country\"\r\n],\r\nas_dict=True\r\n) %}\r\n\r\n{% set original_invoice_date = \"\" %}\r\n\r\n{% if doc.return_against %}\r\n    {% set original_invoice_date =\r\n        frappe.db.get_value(\r\n            \"Sales Invoice\",\r\n            doc.return_against,\r\n            \"posting_date\"\r\n        )\r\n    %}\r\n{% endif %}\r\n\r\n<!-- HEADER -->\r\n<div id=\"header-html\" style=\"height:25px\">\r\n    <div class=\"header-img\"></div>\r\n</div>\r\n\r\n<table style=\"width:100%;\">\r\n    <tr>\r\n        <td style=\"width:20%;\">\r\n            {% set logo = frappe.db.get_value(\"Orion Settings\", None, \"company_logo\") %}\r\n\r\n            {% if logo %}\r\n                <img src=\"{{ logo }}\"\r\n                     style=\"height:65px;  max-width:60%;\">\r\n            {% endif %}\r\n        </td>\r\n\r\n\r\n        <td style=\"width:20%; text-align:right;\">\r\n            <div style=\"\r\n                margin-top:30px;\r\n                font-size:25px;\r\n                font-weight:bold;\r\n                \r\n            \">\r\n                Tax Credit Note\r\n            </div>\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n<!-- COMPANY DETAILS + CREDIT NOTE DETAILS -->\r\n\r\n<table style=\"width:100%; border-collapse:collapse;\">\r\n    <tr>\r\n\r\n        <!-- Company Details -->\r\n        <td style=\"width:65%; vertical-align:top; padding-right:20px;\">\r\n\r\n            <p style=\"margin:0 0 6px 0; font-weight:bold; text-transform:uppercase;font-size:9px;\">\r\n{{ doc.company }}\r\n</p>\r\n        <!-- Company Details -->\r\n        <p style=\"margin:0 0 4px 0; font-size:9px;\">\r\n    {{ company_address[0].address_line1 or \"\" }}<br>\r\n    {% if company_address[0].address_line2 %}{{ company_address[0].address_line2 }}<br>{% endif %}\r\n    {{ company_address[0].city or \"\" }}<br>\r\n    {{ company_address[0].country or \"\" }}{% if company_address[0].pincode %} - {{ company_address[0].pincode }}{% endif %}<br><br>\r\n\r\n    {% if company_address[0].phone %}Phone: {{ company_address[0].phone }}<br>{% endif %}\r\n    {% if company_address[0].email_id %}Email: {{ company_address[0].email_id }}{% endif %}\r\n</p>\r\n            <div style=\"margin-top:8px; font-size:10px; font-weight:bold;\">\r\n                TRN : {{ doc.company_tax_id or \"\" }}\r\n            </div>\r\n\r\n        </td>\r\n\r\n       \r\n\r\n    </tr>\r\n</table>\r\n\r\n<!-- Space -->\r\n\r\n<div style=\"height:10px;\"></div>\r\n\r\n<!-- BILL TO -->\r\n\r\n<table style=\"width:100%; border-collapse:collapse;\">\r\n    <tr>\r\n        <td style=\"width:65%; vertical-align:top;\">\r\n\r\n            <div style=\"font-size:10px; margin-bottom:8px;\">\r\n                Bill To\r\n            </div>\r\n\r\n            <div style=\"font-size:10px; font-weight:bold;text-transform:uppercase\">\r\n                {{ doc.customer_name }}\r\n            </div>\r\n\r\n            {% if customer_address %}\r\n                <div style=\"font-size:10px; margin-top:3px;\">\r\n\r\n                    {{ customer_address.address_line1 or \"\" }}\r\n\r\n                    {% if customer_address.address_line2 %}\r\n                        <br>{{ customer_address.address_line2 }}\r\n                    {% endif %}\r\n\r\n                    <br>\r\n\r\n                    {{ customer_address.city or \"\" }}\r\n\r\n                    {% if customer_address.state %}\r\n                        , {{ customer_address.state }}\r\n                    {% endif %}\r\n\r\n                    {% if customer_address.country %}\r\n                        , {{ customer_address.country }}\r\n                    {% endif %}\r\n                </div>\r\n            {% endif %}\r\n\r\n            <div style=\"margin-top:10px; font-size:10px; font-weight:bold;\">\r\n                TRN {{ doc.tax_id or \"\" }}\r\n            </div>\r\n\r\n        </td>\r\n\r\n         <!-- Credit Note Details -->\r\n        <td style=\"width:25%; vertical-align:top;\">\r\n\r\n    <table style=\"width:100%; border-collapse:collapse; font-size:10px; margin:0;\">\r\n\r\n        <tr>\r\n            <td style=\"white-space:nowrap; padding:2px 0 !important; line-height:1.15;\">\r\n                Credit Date\r\n            </td>\r\n            <td style=\"text-align:center; padding:2px 0 !important; line-height:1.15;width:22px\">\r\n                :\r\n            </td>\r\n            <td style=\"padding:2px 0 !important; line-height:1.15;\">\r\n                {{ frappe.utils.formatdate(doc.posting_date, \"dd MMM yyyy\") }}\r\n            </td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td style=\"white-space:nowrap; padding:2px 0 !important; line-height:1.15;\">\r\n                Credit Note No.#\r\n            </td>\r\n            <td style=\"text-align:center; padding:2px 0 !important; line-height:1.15;\">\r\n                :\r\n            </td>\r\n            <td style=\"padding:2px 0 !important; line-height:1.15;\">\r\n                {{ doc.name }}\r\n            </td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td style=\"white-space:nowrap; padding:2px 0 !important; line-height:1.15;\">\r\n                Ref. Invoice#\r\n            </td>\r\n            <td style=\"text-align:center; padding:2px 0 !important; line-height:1.15;\">\r\n                :\r\n            </td>\r\n            <td style=\"padding:2px 0 !important; line-height:1.15;\">\r\n                {{ doc.return_against or \"\" }}\r\n            </td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td style=\"white-space:nowrap; padding:2px 0 !important; line-height:1.15;\">\r\n                Ref. Invoice Date\r\n            </td>\r\n            <td style=\"text-align:center; padding:2px 0 !important; line-height:1.15;\">\r\n                :\r\n            </td>\r\n            <td style=\"padding:2px 0 !important; line-height:1.15;\">\r\n                {% if original_invoice_date %}\r\n                    {{ frappe.utils.formatdate(original_invoice_date, \"dd MMM yyyy\") }}\r\n                {% endif %}\r\n            </td>\r\n        </tr>\r\n\r\n    </table>\r\n\r\n</td>\r\n    </tr>\r\n</table>\r\n\r\n<br><br>\r\n\r\n<!-- ITEM TABLE -->\r\n\r\n<table style=\"width:100%; border-collapse:collapse; font-size:10px;\">\r\n\r\n    <thead>\r\n        {% if doc.company == \"Orion Environmental Services & Transport LLC\" %}\r\n        <tr style=\"background:#8FAF8A;\">\r\n        {% else %}\r\n        <tr style=\"background:#2f7f4f;\">\r\n            {% endif %}\r\n\r\n    <th style=\"padding:10px 8px; width:4%; text-align:center; color:#fff !important; white-space:nowrap;\">\r\n        #\r\n    </th>\r\n\r\n    <th style=\"padding:10px 8px; width:46%; text-align:left; color:#fff !important; white-space:nowrap;\">\r\n        Item &amp; Description\r\n    </th>\r\n\r\n    <th style=\"padding:10px 8px; width:10%; text-align:center; color:#fff !important; white-space:nowrap;\">\r\n        Tax Rate\r\n    </th>\r\n\r\n    <th style=\"padding:10px 8px; width:8%; text-align:center; color:#fff !important; white-space:nowrap;\">\r\n        Qty\r\n    </th>\r\n\r\n    <th style=\"padding:10px 8px; width:10%; text-align:center; color:#fff !important; white-space:nowrap;\">\r\n        Rate\r\n    </th>\r\n\r\n    <th style=\"padding:10px 8px; width:10%; text-align:center; color:#fff !important; white-space:nowrap;\">\r\n        Amount\r\n    </th>\r\n\r\n    <th style=\"padding:10px 8px; width:6%; text-align:center; color:#fff !important; white-space:nowrap;\">\r\n        Tax\r\n    </th>\r\n\r\n    <th style=\"padding:10px 8px; width:10%; text-align:center; color:#fff !important; white-space:nowrap;\">\r\n        Total\r\n    </th>\r\n\r\n</tr>\r\n    </thead>\r\n\r\n    <tbody>\r\n\r\n        {% for item in doc.items %}\r\n\r\n        {% set tax_amount = (item.amount * 5) / 100 %}\r\n\r\n        <tr style=\"border-bottom:1px solid #e5e5e5;\">\r\n\r\n            <td style=\"padding:12px 8px; vertical-align:top; text-align:center;white-space:nowrap;\">\r\n                {{ loop.index }}\r\n            </td>\r\n\r\n            <td style=\"padding:12px 8px; vertical-align:top; text-align:left; line-height:1.5;\">\r\n                {{ frappe.utils.strip_html(item.description) }}\r\n            </td>\r\n\r\n            <td style=\"padding:12px 8px; vertical-align:top; text-align:center;white-space:nowrap;\">\r\n                {{item.tax_rate}}\r\n            </td>\r\n\r\n            <td style=\"padding:12px 8px; vertical-align:top; text-align:center; white-space:nowrap;\">\r\n    {{ item.qty | abs }}\r\n    <br>\r\n    <span style=\"font-size:10px; color:#666; white-space:nowrap;\">\r\n        ({{ item.uom }})\r\n    </span>\r\n</td>\r\n\r\n            <td style=\"padding:12px 8px; vertical-align:top; text-align:right;white-space:nowrap;\">\r\n                {{ \"{:,.2f}\".format(item.rate) }}\r\n            </td>\r\n\r\n            <td style=\"padding:12px 8px; vertical-align:top; text-align:right;white-space:nowrap;\">\r\n                {{ \"{:,.2f}\".format(item.amount|abs) }}\r\n            </td>\r\n\r\n            <td style=\"padding:12px 8px; vertical-align:top; text-align:right;white-space:nowrap;\">\r\n                {{ \"{:,.2f}\".format(item.tax_amount) }}\r\n            </td>\r\n\r\n            <td style=\"padding:12px 8px; vertical-align:top; text-align:right;white-space:nowrap;\">\r\n                {{ \"{:,.2f}\".format((item.amount + tax_amount)|abs) }}\r\n            </td>\r\n\r\n        </tr>\r\n\r\n        {% endfor %}\r\n\r\n    </tbody>\r\n\r\n</table>\r\n\r\n<br>\r\n\r\n<!-- TOTALS -->\r\n\r\n<table style=\"width:100%; border-collapse:collapse; margin-top:10px;\">\r\n    <tr>\r\n        <td style=\"width:60%;\"></td>\r\n\r\n        <td style=\"width:40%; vertical-align:top;\">\r\n\r\n            <table style=\"width:100%; border-collapse:collapse; font-size:10px;\">\r\n\r\n                <tr>\r\n                    <td style=\"padding:6px 12px;\">\r\n                        Sub Total\r\n                    </td>\r\n\r\n                    <td style=\"padding:6px 12px; text-align:right;\">\r\n                        {{ \"{:,.2f}\".format(doc.total) }} AED\r\n                    </td>\r\n                </tr>\r\n\r\n                <tr>\r\n                    <td style=\"padding:6px 12px;\">\r\n                        Tax (5%)\r\n                    </td>\r\n\r\n                    <td style=\"padding:6px 12px; text-align:right;\">\r\n                        {{ \"{:,.2f}\".format(doc.total_taxes_and_charges) }} AED\r\n                    </td>\r\n                </tr>\r\n                 {% if doc.company == \"Orion Environmental Services & Transport LLC\" %}\r\n                <tr style=\"background:#8FAF8A; color:#fff !important; font-weight:bold;\">\r\n                    {% else %}\r\n                    <tr style=\"background:#2f7f4f; color:#fff !important; font-weight:bold;\">\r\n                    {% endif %}\r\n                    <td style=\"padding:10px 12px;color:#fff !important;\">\r\n                        Total (AED)\r\n                    </td>\r\n\r\n                    <td style=\"padding:10px 12px; text-align:right;color:#fff !important;\">\r\n                        {{ \"{:,.2f}\".format(doc.grand_total) }} AED\r\n                    </td>\r\n                </tr>\r\n\r\n            </table>\r\n\r\n            <div style=\"margin-top:10px; font-size:10px; line-height:1.6;\">\r\n                Total (in words):\r\n                <b>{{ doc.in_words }}</b>\r\n            </div>\r\n\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n\r\n<div style=\"clear:both;\"></div>\r\n\r\n<br><br>\r\n\r\n<!-- TAX SUMMARY -->\r\n\r\n<div style=\"\r\n    font-size:10px;\r\n    font-weight:bold;\r\n    color:#1f6b46;\r\n    text-decoration:underline;\r\n    margin-bottom:12px;\r\n\">\r\n    TAX SUMMARY\r\n</div>\r\n\r\n<table style=\"\r\n    width:100%;\r\n    border-collapse:collapse;\r\n    font-size:10px;\r\n\">\r\n\r\n   <tr style=\"background:#dfe8e3;\">\r\n    <th style=\"text-align:left;color:#1f6b46;padding:10px 12px;\">\r\n        Tax Category\r\n    </th>\r\n\r\n    <th style=\"text-align:center;color:#1f6b46;padding:10px 12px;\">\r\n        Tax Rate\r\n    </th>\r\n\r\n    <th style=\"text-align:right;color:#1f6b46;padding:10px 12px;\">\r\n        Taxable Amount (AED)\r\n    </th>\r\n\r\n    <th style=\"text-align:right;color:#1f6b46;padding:10px 12px;\">\r\n        Tax Amount (AED)\r\n    </th>\r\n</tr>\r\n\r\n    <tr>\r\n\r\n        <td style=\"padding:10px 12px;\">\r\n            Standard Rate (5%)\r\n        </td>\r\n\r\n        <td style=\"padding:10px 12px; text-align:center;\">\r\n            5%\r\n        </td>\r\n\r\n        <td style=\"padding:10px 12px; text-align:right;\">\r\n            {{ \"{:,.2f}\".format(doc.total) }}\r\n        </td>\r\n\r\n        <td style=\"padding:10px 12px; text-align:right;\">\r\n            {{ \"{:,.2f}\".format(doc.total_taxes_and_charges) }}\r\n        </td>\r\n\r\n    </tr>\r\n\r\n    <tr style=\"\r\n        background:#dfe8e3;\r\n        font-weight:bold;\r\n    \">\r\n\r\n        <td style=\"padding:10px 12px;\">\r\n            Total\r\n        </td>\r\n\r\n        <td></td>\r\n\r\n        <td style=\"padding:10px 12px; text-align:right;\">\r\n            AED{{ \"{:,.2f}\".format(doc.total) }}\r\n        </td>\r\n\r\n        <td style=\"padding:10px 12px; text-align:right;\">\r\n            AED{{ \"{:,.2f}\".format(doc.total_taxes_and_charges) }}\r\n        </td>\r\n\r\n    </tr>\r\n\r\n</table>\r\n<div id=\"footer-html\" class=\"visible-pdf\" style=\"width:100%; padding:0 10px;\">\r\n\r\n    <div style=\"width:100%; font-size:9px; position:relative;\">\r\n\r\n        <!-- Green Dashed Line -->\r\n        <div style=\"border-top:2px dashed #2f7f4f; margin-bottom:10px;\"></div>\r\n\r\n        <!-- Footer Details -->\r\n       <table style=\"width:100%; border-collapse:collapse; font-size:9px;\">\r\n    <tr>\r\n\r\n        <td style=\"width:8%; vertical-align:top; white-space:nowrap;\">\r\n            <div>Credit Note</div>\r\n            <div style=\"font-weight:bold; white-space:nowrap;\">\r\n                {{ doc.name }}\r\n            </div>\r\n        </td>\r\n\r\n        <td style=\"width:9%; vertical-align:top; white-space:nowrap;\">\r\n            <div>Credit Date</div>\r\n            <div style=\"font-weight:bold; white-space:nowrap;\">\r\n                {{ frappe.utils.formatdate(doc.posting_date, \"dd MMM yyyy\") }}\r\n            </div>\r\n        </td>\r\n\r\n        <td style=\"width:63%; vertical-align:top;\">\r\n            <div>Bill To</div>\r\n            <div style=\"\r\n                font-weight:bold;\r\n                white-space:nowrap;\r\n                overflow:hidden;\r\n                text-overflow:ellipsis;\r\n            \">\r\n                {{ doc.customer_name }}\r\n            </div>\r\n        </td>\r\n\r\n        <td style=\"\r\n            width:20%;\r\n            text-align:right;\r\n            vertical-align:top;\r\n            font-weight:bold;\r\n            white-space:nowrap;\r\n        \">\r\n            {{ _(\"Page {0} of {1}\").format('<span class=\"page\"></span>', '<span class=\"topage\"></span>') }}\r\n        </td>\r\n\r\n    </tr>\r\n</table>\r\n        <!-- Footer Note -->\r\n        <div style=\"\r\n            text-align:center;\r\n            margin-top:18px;\r\n            font-size:8px;\r\n            color:#444;\r\n        \">\r\n            This is a computer-generated document and is deemed to be signed.\r\n        </div>\r\n\r\n    </div>\r\n\r\n</div>\r\n{% else %}\r\n<div style=\"text-align:center;padding:200px 0;font-size:24px;color:#2f7d4d;font-weight:bold;\">This print format is only for credit notes</div>\r\n{% endif %}",
